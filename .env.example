# =============================================================================
# FilaZero — Environment variables (example)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_NAME=FilaZero
APP_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (CORS).
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---------------------------------------------------------------
# PostgreSQL connection used by Prisma at runtime and for migrations.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://filazero:filazero@localhost:5432/filazero?schema=public
# Direct (non-pooled) connection reserved for migrations when DATABASE_URL
# points to a connection pooler. Not wired into schema.prisma yet: to use it,
# add `directUrl = env("DIRECT_URL")` to the datasource block.
DIRECT_URL=

# --- Authentication ---------------------------------------------------------
# 32+ byte random secret used to sign session tokens. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=
# Session lifetime in seconds (default 7 days).
AUTH_SESSION_TTL_SECONDS=604800
# Password reset token lifetime in seconds (default 1 hour).
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
# TEST/DEV ONLY — returns the raw reset token in the forgot-password response
# because no email provider is configured yet. MUST stay false in production.
AUTH_EXPOSE_RESET_TOKEN=false
# Number of bcrypt rounds used when hashing passwords (>= 10).
PASSWORD_HASH_ROUNDS=12

# --- Bootstrap administrator -----------------------------------------------
# Used only by `npm run db:seed` to create the first real administrator.
# Leave blank to skip seeding. Change the password immediately after first login.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Billing (plans, subscriptions, payments) --------------------------------
# invoice = B2B bank transfer / invoice (real reference, confirmed by webhook)
# stripe  = card checkout through Stripe
PAYMENT_PROVIDER=invoice
# HMAC secret used to verify payment webhooks. WITHOUT THIS THE WEBHOOK REFUSES
# TO RUN — there is no unsigned path that can mark a transaction as paid.
#   openssl rand -base64 48
PAYMENT_WEBHOOK_SECRET=
# Reject webhooks whose timestamp is older than this (anti-replay).
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Optional hosted gateway URL template. Leave blank for B2B bank transfer.
# Example: https://pay.exemplo.ao/checkout?ref={reference}&amount={amount}
PAYMENT_CHECKOUT_URL_TEMPLATE=
# Bank details printed on the B2B invoice and encoded in the bank QR.
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT=
BILLING_BANK_IBAN=
# Acquirer GUI (bank identifier) for the EMVCo bank QR (Tag 26 sub-tag 00).
BILLING_BANK_GUI=
# Trial granted when an organization is created.
TRIAL_DAYS=14
TRIAL_PLAN_CODE=trial

# --- Invoicing / AGT (Angolan tax authority) --------------------------------
# Issuer details printed on every fiscal document.
PLATFORM_TAX_ID=
PLATFORM_LEGAL_NAME=FilaZero
PLATFORM_ADDRESS=
PLATFORM_CITY=Luanda
# Standard VAT (IVA) rate in basis points. 1400 = 14%.
IVA_RATE_BPS=1400
# AGT software-certificate private key (PEM). When set, invoices are signed with
# RSA-SHA256 and marked AGT-certified; otherwise a deterministic HMAC is used.
AGT_PRIVATE_KEY=
# Secret used for the non-certified integrity HMAC. Falls back to
# PAYMENT_WEBHOOK_SECRET when unset.
AGT_HASH_SECRET=

# --- Email (SMTP) -----------------------------------------------------------
# Leave SMTP_HOST blank to disable email delivery (the reset link is then only
# logged / returned outside production through AUTH_EXPOSE_RESET_TOKEN).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FilaZero <no-reply@filazero.local>
SMTP_REQUIRE_TLS=false

# --- Notificações SMS / WhatsApp (Fase 4 · Bloco 3) -------------------------
# SMS: gateway HTTP genérico — POST <SMS_API_URL> com
# `Authorization: Bearer <SMS_API_TOKEN>` e JSON { to, message, sender }.
# Deixe SMS_API_URL/SMS_API_TOKEN em branco para desativar o SMS.
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=FilaZero

# WhatsApp: Meta Cloud API. WHATSAPP_API_BASE é configurável para que a suíte
# de testes aponte para um sink local em vez do Graph API real.
# Deixe WHATSAPP_PHONE_NUMBER_ID/WHATSAPP_ACCESS_TOKEN em branco para desativar.
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Logging ----------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
